DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auto_and_all
ADMIN_PASSWORD=replace-with-a-long-random-password
# Public address of the site, used for canonical URLs and link-preview images.
SITE_URL=https://autoandallautomotive.com

# --- Outgoing email (estimate form) -----------------------------------------
# Estimate requests are emailed to ESTIMATE_TO_EMAIL through this SMTP server.
# Defaults: port 587 with STARTTLS required, so mail is never sent unencrypted.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Set to true only for implicit TLS (normally port 465).
SMTP_SECURE=false
# Refuse to send unless the connection is upgraded to TLS (STARTTLS).
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
# The "From" address. Many providers require it to match the SMTP_USER account.
MAIL_FROM="Auto And All Automotive <estimates@autoandallautomotive.com>"
ESTIMATE_TO_EMAIL=estimates@autoandallautomotive.com
# Leave true in production. Set false only for a local test server that uses a
# self-signed certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
